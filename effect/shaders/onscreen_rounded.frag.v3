#version 140

#include "sdf.glsl"

uniform sampler2D texUnit;
uniform sampler2D sharpTex;
uniform vec2 halfpixel;
uniform vec4 box;
uniform vec4 cornerRadius;
uniform float opacity;

in vec2 uv;
in vec2 vertex;

out vec4 fragColor;

const float BAND = 14.0;
const float LENS_PX = 26.0;
const float DRIFT = 0.10;
const float FROST = 0.06;
const float SAT = 1.18;
const float WASH_BASE = 0.07;
const float WASH_RIM = 0.20;
const float DITHER = 1.0;
const vec2 LIGHT = vec2(-0.45, -1.0);

float gauss(float x)
{
    return exp(-x * x);
}

void main(void)
{
    float f = sdfRoundedBox(vertex, box.xy, box.zw, cornerRadius);
    float df = fwidth(f);
    vec2 gr = vec2(dFdx(f), dFdy(f));
    vec2 n = gr / max(length(gr), 0.0001);

    float k = pow(1.0 - clamp(-f / BAND, 0.0, 1.0), 2.2);

    vec2 inward = -n * vec2(halfpixel.x, -halfpixel.y);
    float cr = textureLod(sharpTex, uv + inward * (LENS_PX * k * (1.0 - DRIFT)), 0.0).r;
    float cg = textureLod(sharpTex, uv + inward * (LENS_PX * k), 0.0).g;
    float cb = textureLod(sharpTex, uv + inward * (LENS_PX * k * (1.0 + DRIFT)), 0.0).b;
    vec3 col = vec3(cr, cg, cb);

    vec3 soft = textureLod(texUnit, uv, 0.0).rgb;
    col = mix(col, soft, FROST);

    float lum = dot(col, vec3(0.299, 0.587, 0.114));
    col = mix(vec3(lum), col, SAT);

    vec2 q = (vertex - box.xy) / max(box.zw, vec2(1.0));
    vec3 wash = vec3(1.00, 0.30, 0.70) * exp(-dot(q - vec2(-0.6, -0.5), q - vec2(-0.6, -0.5)) / 0.8);
    wash += vec3(0.20, 0.90, 1.00) * exp(-dot(q - vec2(0.7, -0.2), q - vec2(0.7, -0.2)) / 0.8);
    wash += vec3(0.60, 0.35, 1.00) * exp(-dot(q - vec2(0.1, 0.8), q - vec2(0.1, 0.8)) / 0.8);
    col += wash * (WASH_BASE + WASH_RIM * k);

    float l = dot(n, normalize(LIGHT));
    float tl = pow(max(l, 0.0), 2.0);
    float brr = pow(max(-l, 0.0), 2.0);
    float line = gauss(f + 1.0);
    float spec = line * (0.04 + 1.15 * tl) + line * brr * 0.22;
    float line2 = gauss((f + 3.0) / 1.2);
    float refl = line2 * brr * 0.45;
    float meniscus = gauss((f + 4.0) / 3.5) * tl * 0.10;
    float fa = (0.35 + 0.45 * abs(l)) * 0.55;
    vec3 prism = vec3(gauss(f + 1.2), gauss(f + 2.0), gauss(f + 2.8)) * fa * 0.38;
    float py = vertex.y - box.y;
    float top = 0.05 * (1.0 - smoothstep(-box.w, box.w * 0.2, py));
    vec3 add = vec3(spec + refl + meniscus + top * (1.0 - k)) + prism;

    float h = fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233))) * 43758.5453);
    col += vec3((h - 0.5) * DITHER / 255.0);

    fragColor = vec4(col + add, 1.0) * opacity;
    fragColor *= 1.0 - clamp(0.5 + f / df, 0.0, 1.0);
}
